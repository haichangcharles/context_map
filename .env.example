# ============ MemGit 本地 API 环境 ============
# Shell 加载: source .env 或 set -a && source .env && set +a
# Python 加载: from dotenv import load_dotenv; load_dotenv()

# 模型服务端密钥（仅服务端使用，不要加 VITE_ 前缀）
# 可选的 OpenAI 兼容提供商（仅在明确选择 openai 时使用）
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-5.3-chat-latest"

# 硅基流动配置（默认优先使用）
SILICONFLOW_API_KEY="YOUR_SILICONFLOW_API_KEY"
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
DEEPSEEK_MODEL="deepseek-ai/DeepSeek-V3"

# 可选的 Gemini 兼容提供商（默认不使用）
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-3-flash-preview"

# 可选：默认 provider（auto/siliconflow/openai/gemini）
DEFAULT_MODEL_PROVIDER="siliconflow"

# APP_URL: The URL where this applet is hosted.
# Set this to your deployed app URL (for callbacks, self-referential links, and API endpoints).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Tavily 搜索
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# Supabase（对话历史同步，可选）
VITE_SUPABASE_URL="https://ueqnlfbzzqmabhlgjpty.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# 单条流式回复最大字符数（0 表示不限制）。达到上限后自动截断并停止流式。
VITE_MAX_STREAM_CHARS="1800"
