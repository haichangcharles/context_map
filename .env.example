# ============ MemGit 本地 API 环境 ============
# Shell 加载: source .env 或 set -a && source .env && set +a
# Python 加载: from dotenv import load_dotenv; load_dotenv()

# 硅基流动 DeepSeek-V3.2（Anthropic 兼容，直接填此 key 即可）
ANTHROPIC_API_KEY="YOUR_ANTHROPIC_API_KEY"
ANTHROPIC_BASE_URL="https://api.siliconflow.cn/v1"

# 硅基流动 OpenAI 兼容接口（可选）
SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"
SILICONFLOW_API_KEY="YOUR_SILICONFLOW_API_KEY"
DEEPSEEK_MODEL="deepseek-ai/DeepSeek-V3.2"

# APP_URL: The URL where this applet is hosted.
# Set this to your deployed app URL (for callbacks, self-referential links, and API endpoints).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Tavily 搜索
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"
