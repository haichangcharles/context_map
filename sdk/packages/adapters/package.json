{
  "name": "@context-map/adapters",
  "version": "0.2.0",
  "description": "Default adapters for Context Map host integrations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "template"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No adapter tests yet\"",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@context-map/core": "^0.2.0"
  },
  "license": "Apache-2.0"
}
