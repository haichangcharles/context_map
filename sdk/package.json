{
  "name": "@context-map/sdk-workspace",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run clean -ws --if-present && npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "pack:check": "npm run pack:check -ws --if-present",
    "verify": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
