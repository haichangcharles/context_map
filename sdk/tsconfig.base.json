{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@context-map/core": ["packages/core/src/index.ts"],
      "@context-map/react": ["packages/react/src/index.ts"],
      "@context-map/adapters": ["packages/adapters/src/index.ts"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true
  }
}
